# Kalp.io Backend Environment Variables
# Copy this file to .env.local for local development

# Gemini API key from Google AI Studio
LLM_API_KEY=your_gemini_api_key_here

# Optional: Pin a specific Gemini model (disables automatic selection)
# LLM_MODEL=your-model-name

# Supabase Postgres: use the Transaction pooler string (port 6543), not the direct connection.
# URL-encode special characters in the password (@ becomes %40, # becomes %23, / becomes %2F).
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-POOLER-HOST].pooler.supabase.com:6543/postgres

# GitHub Webhook Secret for validating incoming GitHub webhook payloads
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Optional: Server Port (defaults to 3001)
PORT=3001
