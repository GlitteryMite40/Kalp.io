# Kalp.io Backend Environment Variables
# Copy this file to .env.local for local development

# LLM API Key (OpenAI, Anthropic, or compatible provider)
LLM_API_KEY=your_llm_api_key_here

# Supabase Postgres connection string (with pooler / direct connection)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# GitHub Webhook Secret for validating incoming GitHub webhook payloads
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Optional: Server Port (defaults to 3001)
PORT=3001
