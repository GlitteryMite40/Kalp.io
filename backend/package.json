{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:check": "tsx --env-file=.env.local src/lib/db.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:smoke": "tsx --env-file=.env.local scripts/db-smoke.ts",
    "llm:check": "tsx --env-file=.env.local scripts/llm-check.ts",
    "llm:check:offline": "tsx scripts/llm-check.ts --offline",
    "test:schema": "tsx scripts/test-schema.ts",
    "test:prompts": "tsx scripts/test-prompts.ts",
    "test:extract": "tsx scripts/test-extract.ts",
    "test:architecture": "tsx scripts/test-architecture.ts",
    "test:decompose": "tsx scripts/test-decompose.ts",
    "test:validate": "tsx scripts/test-validate.ts",
    "test:criteria": "tsx scripts/test-criteria.ts",
    "test:prompt": "tsx scripts/test-prompt.ts",
    "test:save-plan": "tsx --env-file=.env.local scripts/test-save-plan.ts",
    "test:session": "tsx --env-file=.env.local scripts/test-session.ts",
    "test:projects": "tsx --env-file=.env.local scripts/test-post-projects.ts",
    "test:graph": "tsx --env-file=.env.local scripts/test-get-graph.ts",
    "test:node": "tsx --env-file=.env.local scripts/test-patch-node.ts",
    "test:run": "tsx --env-file=.env.local scripts/test-run-stage.ts",
    "test:rate-limit": "tsx --env-file=.env.local scripts/test-rate-limit.ts",
    "test:health": "tsx --env-file=.env.local scripts/test-health.ts",
    "test:delete-project": "tsx --env-file=.env.local scripts/test-delete-project.ts",
    "test:webhook": "tsx scripts/test-webhook.ts",
    "test:apply-commit": "tsx --env-file=.env.local scripts/test-apply-commit.ts",
    "test": "npm run test:schema && npm run test:prompts && npm run test:extract && npm run test:architecture && npm run test:decompose && npm run test:validate && npm run test:criteria && npm run test:prompt && npm run test:save-plan && npm run test:session && npm run test:projects && npm run test:graph && npm run test:node && npm run test:run && npm run test:rate-limit && npm run test:health && npm run test:delete-project && npm run test:webhook && npm run test:apply-commit && npm run llm:check:offline",
    "prompt:smoke": "tsx --env-file=.env.local scripts/prompt-smoke.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
