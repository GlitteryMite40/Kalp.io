{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:check": "tsx --env-file=.env.local src/lib/db.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:smoke": "tsx --env-file=.env.local scripts/db-smoke.ts",
    "llm:check": "tsx --env-file=.env.local scripts/llm-check.ts",
    "llm:check:offline": "tsx scripts/llm-check.ts --offline",
    "test:schema": "tsx scripts/test-schema.ts",
    "test:prompts": "tsx scripts/test-prompts.ts",
    "test:extract": "tsx scripts/test-extract.ts",
    "test": "npm run test:schema && npm run test:prompts && npm run test:extract && npm run llm:check:offline",
    "prompt:smoke": "tsx --env-file=.env.local scripts/prompt-smoke.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
